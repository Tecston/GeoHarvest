# Landing: localhost:5173. Product platform: localhost:3000.
# Optional: defaults to localhost:3000 in development, app.geoharvest.org in production.
VITE_PLATFORM_URL=http://localhost:3000

# Optional legacy account service. Leave empty for the demo without accounts.
# Use only the public anon/publishable key, never a service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
